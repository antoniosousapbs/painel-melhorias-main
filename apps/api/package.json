{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs'),path=require('path');const src=path.resolve('templates');const dst=path.resolve('dist/templates');if(fs.existsSync(src)){fs.cpSync(src,dst,{recursive:true});console.log('✅ templates/ copiado para dist/templates/');}\"",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "verify:excel": "tsx src/db/verify-excel-template.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "jwks-rsa": "^4.0.1",
    "mssql": "^10.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
